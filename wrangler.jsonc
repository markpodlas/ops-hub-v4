{
  "name": "ops-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-03-16",
  "assets": {
  "directory": "./public",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application",
  "run_worker_first": true
  },
  // Non-secret config. GEMINI_API_KEY is a SECRET — `npx wrangler secret put
  // GEMINI_API_KEY` (this repo is public; never put the key in this file).
  "vars": {
    // Video Review module. gemini-2.5-flash RETIRES 2026-10-16 — swapping this
    // string is the entire migration path, no code change needed.
    "GEMINI_MODEL": "gemini-2.5-flash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-calendar",
      "database_id": "ef9c3aff-9755-4c6c-9b75-2d09e7916823"
    },
    {
      "binding": "CX_AGENT_DB",
      "database_name": "cx-agent",
      "database_id": "47d05b88-dfae-4755-a52e-3115ab6d09ff"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CX_UPLOADS",
      "bucket_name": "cx-agent-uploads"
    },
    {
      "binding": "MED_IMAGES",
      "bucket_name": "med-supplies-images"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
