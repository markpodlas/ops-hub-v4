{
  "name": "ops-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-03-16",
  "assets": {
  "directory": "./public",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application",
  "run_worker_first": true
  },
  // Non-secret config. GEMINI_API_KEY is a SECRET — `npx wrangler secret put
  // GEMINI_API_KEY` (this repo is public; never put the key in this file).
  "vars": {
    // Video Review module: the DEFAULT model. A model chosen in the UI is saved
    // in D1 and wins over this, so day-to-day switching needs no deploy.
    // Google retires Gemini models — and cuts them off for existing keys ahead
    // of the published date — so treat this as a starting point, not a constant.
    "GEMINI_MODEL": "gemini-3.6-flash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-calendar",
      "database_id": "ef9c3aff-9755-4c6c-9b75-2d09e7916823"
    },
    {
      "binding": "CX_AGENT_DB",
      "database_name": "cx-agent",
      "database_id": "47d05b88-dfae-4755-a52e-3115ab6d09ff"
    },
    {
      // READ-ONLY. Owned by the qbank project; holds textbook_chunks.text, the
      // passages Vectorize ids point at. Never write to this from ops-hub.
      "binding": "QBANK_DB",
      "database_name": "nitm-qbank",
      "database_id": "5d018ddd-a9ed-48c4-89f3-1db05a6bd6b0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CX_UPLOADS",
      "bucket_name": "cx-agent-uploads"
    },
    {
      "binding": "MED_IMAGES",
      "bucket_name": "med-supplies-images"
    },
    {
      "binding": "VIDEO_REVIEW_UPLOADS",
      "bucket_name": "nitm-video-review"
    }
  ],
  // RAG grounding for Video Review. The nursing textbook corpus already exists,
  // built by the qbank project: 43,990 embedded chunks across 8 titles
  // (including Davis's Drug Guide and Ford's Clinical Pharmacology).
  // Vectorize holds the embeddings + citation metadata; the passage TEXT lives in
  // nitm-qbank.textbook_chunks, keyed by the same id. Both are READ-ONLY here —
  // ops-hub must never write to the qbank database.
  "vectorize": [
    {
      "binding": "TEXTBOOKS",
      "index_name": "nitm-textbooks"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
